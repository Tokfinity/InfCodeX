{
  "name": "infcodex",
  "version": "0.7.14-beta.7",
  "description": "极致轻量化 Coding Agent - TypeScript 实现，支持7种LLM提供商",
  "type": "module",
  "private": false,
  "workspaces": [
    "packages/*"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "infcodex": "./dist/kodax_cli.js",
    "kodax": "./dist/kodax_cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "npm run build:packages && tsc",
    "prepack": "npm run build && npm run verify:publish",
    "build:packages": "tsc -b tsconfig.build.json && npm run copy:builtin -w @kodax/skills",
    "dev": "npm run dev:packages & tsx src/kodax_cli.ts",
    "dev:cli": "tsx src/kodax_cli.ts",
    "dev:packages": "tsc -b tsconfig.build.json --watch --preserveWatchOutput",
    "probe:reasoning": "tsx scripts/probe-reasoning.ts",
    "repointel:demo": "node scripts/repointel-demo.mjs",
    "repointel:doctor": "node scripts/repointel-doctor.mjs",
    "start": "node dist/kodax_cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "clean:packages": "npm run clean --workspaces",
    "verify:publish": "node scripts/verify-publish.mjs",
    "publish:all": "node scripts/publish-all.mjs",
    "release:infcodex": "node scripts/release-infcodex.mjs",
    "unpublish:all": "node scripts/unpublish-all.mjs"
  },
  "keywords": [
    "ai",
    "coding-agent",
    "llm",
    "anthropic",
    "openai",
    "cli"
  ],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.15.0",
    "@kodax/coding": "*",
    "@kodax/repl": "*",
    "@kodax/skills": "*",
    "aamp-sdk": "^0.1.14",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "glob": "^11.0.1",
    "iconv-lite": "^0.6.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.0",
    "ink": "^6.7.0",
    "ink-testing-library": "^4.0.0",
    "react": "^19.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/icetomoyo/KodaX.git"
  }
}
