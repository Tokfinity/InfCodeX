{
  "name": "@kodax-ai/agent",
  "version": "0.7.49",
  "description": "KodaX Agent — 通用 Agent 框架（智能体底座）。Agent / Runner / Handoff / Guardrail / Admission / Messaging / Orchestration / Memory / Team / Scratchpad / Construction / Runtime middleware。不绑定 coding。",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./messaging/queue": {
      "types": "./dist/messaging/queue.d.ts",
      "import": "./dist/messaging/queue.js"
    },
    "./capabilities/mcp": {
      "types": "./dist/capabilities/mcp/index.d.ts",
      "import": "./dist/capabilities/mcp/index.js"
    },
    "./capabilities/skills": {
      "types": "./dist/capabilities/skills/index.d.ts",
      "import": "./dist/capabilities/skills/index.js"
    },
    "./capabilities/skills/shared/yaml": {
      "types": "./dist/capabilities/skills/shared/yaml.d.ts",
      "import": "./dist/capabilities/skills/shared/yaml.js"
    },
    "./tracing": {
      "types": "./dist/tracing/index.d.ts",
      "import": "./dist/tracing/index.js"
    },
    "./session-lineage": {
      "types": "./dist/session-lineage/index.d.ts",
      "import": "./dist/session-lineage/index.js"
    },
    "./workflow": {
      "types": "./dist/workflow/index.d.ts",
      "import": "./dist/workflow/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b && npm run copy:builtin",
    "dev": "tsc --watch",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "copy:builtin": "node -e \"require('fs').cpSync('src/capabilities/skills/builtin','dist/capabilities/skills/builtin',{recursive:true})\""
  },
  "dependencies": {
    "@kodax-ai/llm": "*",
    "js-tiktoken": "^1.0.12",
    "fflate": "^0.8.2",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/icetomoyo/KodaX.git",
    "directory": "packages/agent"
  },
  "license": "Apache-2.0",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
