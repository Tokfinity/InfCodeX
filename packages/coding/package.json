{
  "name": "@kodax-ai/coding",
  "version": "0.7.43",
  "description": "KodaX Coding Agent - Coding \u5de5\u5177 + Prompts",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./repo-intelligence-bridge": {
      "types": "./dist/repo-intelligence/public-bridge.d.ts",
      "import": "./dist/repo-intelligence/public-bridge.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc --watch",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@kodax-ai/agent": "*",
    "@kodax-ai/llm": "*",
    "@kodax-ai/repointel-protocol": "*",
    "@kodax-ai/session-lineage": "*",
    "@kodax-ai/skills": "*",
    "glob": "^11.0.1",
    "iconv-lite": "^0.6.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@lezer/common": "^1.5.1",
    "@lezer/go": "^1.0.1",
    "@lezer/python": "^1.1.18",
    "@lezer/rust": "^1.0.2",
    "@types/node": "^22.13.4",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "@kodax-ai/llm": "*"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/icetomoyo/KodaX.git",
    "directory": "packages/coding"
  },
  "license": "Apache-2.0",
  "optionalDependencies": {
    "@lezer/common": "^1.5.1",
    "@lezer/go": "^1.0.1",
    "@lezer/python": "^1.1.18",
    "@lezer/rust": "^1.0.2"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
