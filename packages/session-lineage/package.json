{
  "name": "@kodax/session-lineage",
  "version": "0.7.35.1",
  "description": "KodaX Session Lineage — Session 实体 + 持久化 + Lineage 追踪 + LineageCompaction + DefaultSummaryCompaction。@kodax/agent 的会话子系统（v0.7.35.1 后承接从 @kodax/agent 回流的 session/persistence/compaction）。",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc --watch",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@kodax/ai": "*",
    "@kodax/agent": "*"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/icetomoyo/KodaX.git",
    "directory": "packages/session-lineage"
  },
  "license": "Apache-2.0"
}
