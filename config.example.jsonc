{
  // ════════════════════════════════════════════════════════════════════
  // KodaX 配置模板 (Config Template)
  //
  // 将本文件复制到 ~/.kodax/config.json 并按需修改。
  // 提示:
  //   - 真正的 config.json 必须是合法 JSON(不支持注释/尾逗号)——复制后请去掉注释。
  //   - 所有字段均为可选,只写你关心的即可。
  //   - 字段优先级:SDK 选项 > CLI 参数 > shell 环境变量 > 本配置文件 > 默认值。
  //     对会桥接到环境变量的设置(如模型档位/fallback/repo-intel),启动前在 shell
  //     里设的环境变量会覆盖本文件;本文件是持久偏好的来源,环境变量是临时覆盖。
  //   - 权威定义见 packages/repl/src/common/utils.ts :: loadConfig()。
  // ════════════════════════════════════════════════════════════════════

  // ─── 1. 基础模型配置 ────────────────────────────────────────────────

  // 默认 provider。内置:anthropic | openai | deepseek | kimi | qwen
  //   | zhipu | zhipu-coding | zai-coding | minimax-coding | mimo | ark-coding
  //   | gemini-cli | codex-cli … 也可填下方自定义 provider 的 name。
  "provider": "zhipu-coding",

  // 当前 provider 使用的模型 ID(可选,缺省用 provider 默认模型)。
  // "model": "glm-5.2",

  // 子 Agent 模型档位 fast/deep(可选)。workflow 脚本 / dispatch 用
  //   modelHint:'fast'|'deep' 表达档位意图(不写具体模型名),这里把档位映射到
  //   真实 provider+model。fast 只对只读子 Agent 生效(写/改代码的子 Agent 不降级);
  //   未配的档位继承父 Agent 模型。也可用环境变量 KODAX_FAST/DEEP_PROVIDER/MODEL
  //   覆盖本配置(shell 里设的会赢,见文件末尾)。
  // "fastProvider": "deepseek",
  // "fastModel": "deepseek-v4-flash",
  // "deepProvider": "zhipu-coding",
  // "deepModel": "glm-5.2",

  // 推理投入 Reasoning effort(当前模型能力派生;运行时按模型能力自动适配)。
  //   "auto"   清除显式设置 → 用模型默认(很多模型会落到 max/high)
  //   "off"    关闭思考(内部规范化为 none)
  //   "low" | "medium" | "high" | "xhigh" | "max"
  // 不是所有模型都支持全部档位:不支持的会自动别名或被记录后从梯子移除
  // (见下方"能力缓存"说明)。用 Ctrl+T 在当前模型支持的档位间循环。
  "effort": "auto",

  // Agent 模式:"ama"(adaptive multi-agent,默认)| "amaw" | "sa"
  // "agentMode": "ama",

  // 权限模式:"plan" | "accept-edits"(默认)| "auto"
  //   - plan:         只读规划,修改类工具一律请求确认
  //   - accept-edits: 自动允许文件编辑,shell 命令仍需确认
  //   - auto:         LLM 分类器对每次工具调用做风险判定(见 §8 autoMode)
  "permissionMode": "accept-edits",

  // UI 语言:"en" | "zh" | "auto"(按 LANG/LC_ALL 自动检测)。
  // "locale": "zh",

  // ─── 2. Provider 可选模型列表 providerModels(可选) ─────────────────
  // 扩展/重排某个内置 provider 的 /model 可选模型列表。
  // 配置中的模型优先显示,未在列表的内置模型会追加到后面。
  // "providerModels": {
  //   "anthropic":    ["claude-sonnet-4-6", "claude-opus-4-8", "claude-haiku-4-5"],
  //   "openai":       ["gpt-5.4", "gpt-5.3-codex"],
  //   "zhipu-coding": ["glm-5.2", "glm-5.1"]
  // },

  // ─── 3. 自定义 Provider customProviders(可选) ──────────────────────
  // 注册任意 OpenAI / Anthropic 协议兼容网关。注册后 "provider" 字段可直接
  // 引用其 name。注意:自定义 provider 名不能与内置 provider 同名。
  //
  // 关于 reasoning(推理能力声明)——只需一个字段:
  //   "reasoning": { "efforts": [...], "default": "..." }
  //       列出该模型接受的档位,顺序即 Ctrl+T 梯子;含 "off" 表示可关思考。
  //       wire 策略(effortStrategy 等)由 protocol 自动推导,你不用关心。
  //   "reasoning": "none"
  //       该模型不支持思考。
  //   不写 reasoning ⇒ 默认乐观给全量梯子(off/low/medium/high/xhigh/max),
  //       不支持的档位会在首次被真实请求拒绝后自动记录并移除(被动学习)。
  //   高级:需要完全自定义时用 "reasoningProfile": { ... }(原始 profile)。
  //
  // "customProviders": [
  //   // ── OpenAI 协议族示例 ──
  //   {
  //     "name": "my-ollama",                    // 必填:provider 唯一标识
  //     "protocol": "openai",                    // "openai" | "anthropic"
  //     "baseUrl": "http://localhost:11434/v1",  // 必填
  //     "apiKeyEnv": "OLLAMA_API_KEY",           // 必填:API Key 的环境变量名
  //     "model": "llama3",                       // 必填:默认模型 ID
  //     "models": ["codellama", "mistral"],      // 可选:其它可用模型
  //     "userAgentMode": "compat",               // "compat"(默认,UA=KodaX)| "sdk"
  //     "reasoning": { "efforts": ["off", "low", "high"], "default": "high" },
  //     // OpenAI-compat 思考模型若需回放 reasoning_content(如 DeepSeek V4)
  //     // 才开启;OpenAI 原生 / 拒绝未知字段的网关保持 false:
  //     //   "replayReasoningContent": true
  //     "contextWindow": 128000,
  //     "maxOutputTokens": 4096
  //   },
  //
  //   // ── Anthropic 协议族示例 ──
  //   {
  //     "name": "my-claude-proxy",
  //     "protocol": "anthropic",
  //     "baseUrl": "https://my-proxy.example.com",
  //     "apiKeyEnv": "PROXY_API_KEY",
  //     "model": "claude-sonnet-4-6",
  //     "models": ["claude-opus-4-8", "claude-haiku-4-5"],
  //     "reasoning": { "efforts": ["low", "medium", "high", "max"], "default": "high" },
  //     "contextWindow": 200000,
  //     "maxOutputTokens": 32768
  //   },
  //
  //   // ── 不支持思考的模型 ──
  //   {
  //     "name": "my-plain-llm",
  //     "protocol": "openai",
  //     "baseUrl": "https://plain.example/v1",
  //     "apiKeyEnv": "PLAIN_API_KEY",
  //     "model": "fast-chat",
  //     "reasoning": "none"
  //   }
  // ],
  //
  // 注:旧字段 reasoningPreset / reasoningCapability / supportsThinking 已废弃,
  // 仅为兼容老配置在加载时自动迁移,新配置请用上面的 "reasoning"。

  // ─── 能力缓存 capability-cache.json(只读说明,勿手写) ─────────────
  // KodaX 会把"某 provider/model 实测拒绝的 effort 档位"记录到
  // ~/.kodax/capability-cache.json(被动学习,自动管理)。这不是你要维护的
  // 配置:它只会收窄梯子,记错了可用 /provider forget-capability 清除。
  //
  // 注:另有一个独立的旧字段 providerReasoningOverrides,记录的是 V1 推理
  // "机制"(toggle/effort/budget),与上面的 effort 值缓存是不同维度;它仍被
  // 运行时机制自动纠正使用,通常无需手写。

  // ─── 4. 压缩配置 compaction ─────────────────────────────────────────
  //   enabled                (bool,  默认 true)  是否开启自动压缩
  //   triggerPercent         (0..100 默认 75)    上下文使用率超过此值触发
  //   protectionPercent      (0..100 默认 20)    最近多少比例的上下文不压缩
  //   rollingSummaryPercent  (0..100 默认 10)    每轮滚动摘要处理的窗口比例
  //   pruningThresholdTokens (int,   默认 500)   超过该 token 数的工具结果会被裁剪
  //   contextWindow          (int)               手动覆盖,最高优先级
  "compaction": {
    "enabled": true,
    "triggerPercent": 75
  },

  // ─── 5. 总是允许的工具模式 alwaysAllowTools(可选) ──────────────────
  // accept-edits 模式下自动放行的 Bash 命令模式。项目级配置
  //   "Bash(npm install)"   精确匹配
  //   "Bash(git commit:*)"  前缀通配
  //   "Bash(npm:*)"         命令前缀通配
  // 注意:"Bash(*)" 出于安全会被拒绝写入。
  // "alwaysAllowTools": [
  //   "Bash(git status)",
  //   "Bash(git diff:*)",
  //   "Bash(npm test:*)"
  // ],

  // ─── 6. MCP 服务器 mcpServers(可选) ────────────────────────────────
  // 注册外部 MCP 服务器,支持 stdio / sse / streamable-http 三种传输。
  // "mcpServers": {
  //   "my-stdio-server": {
  //     "type": "stdio",
  //     "command": "node",
  //     "args": ["./mcp-server.js"],
  //     "connect": "lazy"
  //   },
  //   "my-http-server": {
  //     "type": "streamable-http",
  //     "url": "https://mcp.example.com",
  //     "headers": { "Authorization": "Bearer ${MY_TOKEN}" },
  //     "connect": "prewarm"
  //   }
  // },

  // ─── 7. 本地扩展 extensions(可选) ──────────────────────────────────
  // 启动时加载的本地扩展模块(.js/.mjs/.cjs/.ts)。相对路径相对于
  // ~/.kodax/config.json 所在目录解析;也可用 CLI --extension 覆盖。
  // "extensions": [
  //   "./extensions/my-ext.mjs"
  // ],

  // ─── 8. Auto Mode 分类器(仅 permissionMode = "auto" 时生效) ────────
  //   engine            "llm"(默认)| "rules"
  //   classifierModel   "provider:model" 或 "model"(缺省用主会话模型)
  //   timeoutMs         分类器超时(毫秒),默认 8000
  //   speculativeWindowMs 投机分类窗口(毫秒),默认 500(0 关闭)
  // 环境变量覆盖:KODAX_AUTO_MODE_ENGINE / KODAX_AUTO_MODE_CLASSIFIER_MODEL …
  // "autoMode": {
  //   "engine": "llm",
  //   "timeoutMs": 8000,
  //   "speculativeWindowMs": 500
  // },

  // ─── 9. 仓库智能 Repo Intelligence ──────────────────────────────────
  // repoIntelligenceMode:
  //   "auto"  自动选择最佳引擎(默认)
  //   "full"  完整仓库智能
  //   "light" 轻量
  //   "off"   关闭注入
  // "repoIntelligenceMode": "auto",
  // "repoIntelligenceTrace": false,

  // ─── 10. 流式稳健性 streamIdleTimeoutMs(可选) ─────────────────────
  // 流式响应空闲超时(毫秒),0 = 禁用。对应 KODAX_STREAM_IDLE_TIMEOUT_MS。
  // "streamIdleTimeoutMs": 120000,

  // ─── 11. Sidecar Verifier 日志(可选) ──────────────────────────────
  // 开启后持久化 verifier gate + verdict 摘要,等价于 KODAX_VERIFIER_LOG=1。
  // "verifierLog": true,

  // ─── 12. 运行时设置(会桥接到对应环境变量,shell 覆盖本文件)──────────
  // "maxOutputTokens": 8192,        // 每次 provider 调用的最大输出 token(成本闸)
  // "disablePromptCache": false,    // true = 关闭 Anthropic prompt 缓存
  // "lsp": true,                    // false = 关闭 LSP 辅助诊断
  // "lspAutoDownload": false,       // true = 允许自动下载 LSP server 二进制
  // "acpLogLevel": "info",          // ACP serve 日志级别
  // "sessionRetentionDays": 0,      // >0 = 后台清理这么多天前的会话文件(默认不清)

  // ─── 13. 仓库智能 worker 调优(可选,一般不用改)────────────────────
  // "repoIntelligence": {
  //   "toolWaitMs": 8000,           // 工具等待仓库智能结果的超时
  //   "workerTimeoutMs": 60000,     // 语义 worker 超时
  //   "workerOldSpaceMb": 2048,     // 语义 worker 的 V8 堆上限
  //   "storageDir": "…"             // 仓库智能索引的存储目录
  // },

  // ─── 14. 工作流(run_workflow)引擎(可选)──────────────────────────
  // "workflow": {
  //   "maxConcurrency": 8            // 同时运行的 workflow 子 Agent 上限
  //                                  // (默认 8;加上主 Agent + Sidecar ≈ 10 同时在跑)
  //                                  // 范围 [1, 32];脚本 manifest 只能往下压不能抬高
  // },

  // 相关环境变量(不写进 JSON,在 shell 里设置。优先级:shell env > 本文件):
  //   KODAX_VERIFIER_LOG=1            打开 verifier 诊断日志
  //   KODAX_EFFORT=<value>           启动时覆盖 effort(auto/off/low/…/max)
  //   上面 §1/§12/§13 的字段各自对应一个 KODAX_* 环境变量(如 maxOutputTokens ↔
  //   KODAX_MAX_OUTPUT_TOKENS、fastProvider ↔ KODAX_FAST_PROVIDER),在 shell 里设了
  //   就临时覆盖本文件。子 Agent 档位覆盖:KODAX_FAST/DEEP_PROVIDER / _MODEL。
  //
  // 仅环境变量(启动早期/模块加载时读取,配置文件那时还没加载,故无法用 config 字段):
  //   KODAX_HEAP_LIMIT=<MB>          子进程 V8 堆上限(默认 4096;主进程用启动脚本设)
  //   KODAX_PROVIDER=<name>          缺省 provider 的兜底默认;日常请直接用上面的
  //                                  "provider" 字段(它是 provider 的配置来源)
}
